/* Titan Sumo Bot - 01d All Sensors Test
   Use with: Section 1, Part D

   Goal: check all four sensors at once and make sure each one only
   changes when you test THAT sensor.
   The wheels do NOT drive in this sketch.

   How to use:
   1. Upload, then open Tools > Serial Monitor (9600 baud).
   2. Test each sensor one at a time. Only its column should change.
   3. If the wrong column changes, check for crossed wires or wrong pins.
*/

#include <Servo.h>

// Servo pins
const int LEFT_SERVO_PIN  = A5;
const int RIGHT_SERVO_PIN = A4;

// Line sensor pins
const int LINE_LEFT_PIN  = A3;
const int LINE_RIGHT_PIN = A2;

// IR (enemy) sensor pins
const int ENEMY_LEFT_PIN  = A1;
const int ENEMY_RIGHT_PIN = A0;

// Stop values. Copy your trimmed values from sketch 01a.
const int LEFT_STOP  = 90;
const int RIGHT_STOP = 90;

Servo leftServo;
Servo rightServo;

void setup()
{
  delay(1000);
  Serial.begin(9600);

  // Hold the wheels still
  leftServo.attach(LEFT_SERVO_PIN);
  rightServo.attach(RIGHT_SERVO_PIN);
  leftServo.write(LEFT_STOP);
  rightServo.write(RIGHT_STOP);

  pinMode(LINE_LEFT_PIN, INPUT_PULLUP);
  pinMode(LINE_RIGHT_PIN, INPUT_PULLUP);

  Serial.println("All sensors test");
  Serial.println("Line: 0 = WHITE, 1 = black   IR: 0 to 1023, higher = closer");
}

void loop()
{
  int leftLine   = digitalRead(LINE_LEFT_PIN);
  int rightLine  = digitalRead(LINE_RIGHT_PIN);
  int enemyLeft  = analogRead(ENEMY_LEFT_PIN);
  int enemyRight = analogRead(ENEMY_RIGHT_PIN);

  Serial.print("Line L: ");
  Serial.print(leftLine);
  Serial.print(" | Line R: ");
  Serial.print(rightLine);
  Serial.print(" | IR L: ");
  Serial.print(enemyLeft);
  Serial.print(" | IR R: ");
  Serial.println(enemyRight);

  delay(200);  // slow the printing down so you can read it
} 
