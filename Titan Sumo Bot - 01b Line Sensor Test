/* Titan Sumo Bot - 01b Line Sensor Test
   Use with: Section 1, Part B

   Goal: see what each line sensor reads on black and on white,
   both as a digital value (0 or 1) and as an analog value (0 to 1023).
   The wheels do NOT drive in this sketch.

   How to use:
   1. Upload, then open Tools > Serial Monitor (9600 baud).
   2. Slide the bot slowly so only the LEFT sensor crosses onto white.
   3. Repeat for the RIGHT sensor.
   4. Record both readings for each sensor in your sensor table.
   The onboard LED turns on whenever either sensor sees white.

   Note: the analog reading is taken with INPUT_PULLUP turned on, the
   same way the base code sets up these pins. If the analog number only
   ever sits near 0 or near 1023, your sensor has a digital output.
*/

#include <Servo.h>

// Servo pins
const int LEFT_SERVO_PIN  = A5;
const int RIGHT_SERVO_PIN = A4;

// Line sensor pins
const int LINE_LEFT_PIN  = A3;
const int LINE_RIGHT_PIN = A2;

// Stop values. Copy your trimmed values from sketch 01a.
const int LEFT_STOP  = 90;
const int RIGHT_STOP = 90;

Servo leftServo;
Servo rightServo;

void setup()
{
  delay(1000);
  Serial.begin(9600);
  pinMode(LED_BUILTIN, OUTPUT);

  // Hold the wheels still
  leftServo.attach(LEFT_SERVO_PIN);
  rightServo.attach(RIGHT_SERVO_PIN);
  leftServo.write(LEFT_STOP);
  rightServo.write(RIGHT_STOP);

  // INPUT_PULLUP keeps the pin HIGH until the sensor pulls it LOW (white)
  pinMode(LINE_LEFT_PIN, INPUT_PULLUP);
  pinMode(LINE_RIGHT_PIN, INPUT_PULLUP);

  Serial.println("Line sensor test. Digital: 0 = WHITE, 1 = black. Analog: 0 to 1023.");
}

void loop()
{
  // Digital readings: 0 or 1
  int leftLine  = digitalRead(LINE_LEFT_PIN);
  int rightLine = digitalRead(LINE_RIGHT_PIN);

  // Analog readings from the same pins: 0 to 1023
  int leftAnalog  = analogRead(LINE_LEFT_PIN);
  int rightAnalog = analogRead(LINE_RIGHT_PIN);

  // Left sensor
  Serial.print("Line L: ");
  Serial.print(leftLine);
  if (leftLine == LOW)
  {
    Serial.print(" (WHITE)");
  }
  else
  {
    Serial.print(" (black)");
  }
  Serial.print("  analog ");
  Serial.print(leftAnalog);

  // Right sensor
  Serial.print("    Line R: ");
  Serial.print(rightLine);
  if (rightLine == LOW)
  {
    Serial.print(" (WHITE)");
  }
  else
  {
    Serial.print(" (black)");
  }
  Serial.print("  analog ");
  Serial.println(rightAnalog);

  // LED on if either sensor sees white
  if (leftLine == LOW || rightLine == LOW)
  {
    digitalWrite(LED_BUILTIN, HIGH);
  }
  else
  {
    digitalWrite(LED_BUILTIN, LOW);
  }

  delay(200);  // slow the printing down so you can read it
} 
